# 복사해서 .env.local 로 저장한 뒤 값을 채운다. (.env.local 은 git 에 올라가지 않음)

# Kakao REST API 키. 넣으면 지역 검색·현재 위치 이름이 Kakao 로 바뀐다
# (동 단위 검색 정확, 입력 중 자동 검색). 비우면 OpenStreetMap Nominatim 사용.
KAKAO_REST_API_KEY=

# 날씨 제공자. open-meteo(예보만) 또는 kma(기상청 실시간 관측 + 예보, KMA_API_KEY 필요).
WEATHER_PROVIDER=open-meteo

# 기상청 API허브(https://apihub.kma.go.kr) 마이페이지의 인증키. WEATHER_PROVIDER=kma 일 때 필요.
KMA_API_KEY=
